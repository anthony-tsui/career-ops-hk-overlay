# Overlay environment template.
# Copy to .env and fill it on your machine. Do not commit .env.
# Do not paste a live token into this example file.
#
# Integration token: https://www.notion.so/my-integrations
# Set NOTION_ACCESS_TOKEN in .env only.
#
# Hunt database. See config/hunt.example.yml.
# This overlay ships no Notion id.
NOTION_HUNT_DATA_SOURCE_ID=replace-me
NOTION_HUNT_BOARD_PAGE_URL=
NOTION_HUNT_STATUS_MAP_URL=
